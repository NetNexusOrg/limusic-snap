Add European Portuguese (pt-PT) to the language picker.

Upstream ships ui/src/lib/locales/pt.json but never registers it, so Portuguese
browsers fall back to pt-BR. The id is pt-PT because it is sent to YouTube as
`hl` and `hl=pt` answers with Brazilian Portuguese.

--- a/ui/src/lib/locales/index.ts
+++ b/ui/src/lib/locales/index.ts
@@ -11,6 +11,7 @@
 import ja from './ja.json';
 import ko from './ko.json';
 import pl from './pl.json';
+import ptPT from './pt.json';
 import ptBR from './pt_BR.json';
 import ro from './ro.json';
 import ru from './ru.json';
@@ -31,6 +32,7 @@
 	| 'es'
 	| 'fr'
 	| 'tr'
+	| 'pt-PT'
 	| 'pt-BR'
 	| 'id'
 	| 'ro'
@@ -71,6 +73,7 @@
 	{ id: 'ja', nativeLabel: '日本語', englishLabel: 'Japanese' },
 	{ id: 'ko', nativeLabel: '한국어', englishLabel: 'Korean' },
 	{ id: 'pl', nativeLabel: 'Polski', englishLabel: 'Polish' },
+	{ id: 'pt-PT', nativeLabel: 'Português (Portugal)', englishLabel: 'Portuguese (Portugal)' },
 	{ id: 'pt-BR', nativeLabel: 'Português (Brasil)', englishLabel: 'Portuguese (Brazil)' },
 	{ id: 'ro', nativeLabel: 'Română', englishLabel: 'Romanian' },
 	{ id: 'ru', nativeLabel: 'Русский', englishLabel: 'Russian' },
@@ -93,6 +96,7 @@
 	es,
 	fr,
 	tr,
+	'pt-PT': ptPT,
 	'pt-BR': ptBR,
 	id,
 	ro,
